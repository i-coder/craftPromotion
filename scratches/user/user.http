### /api/deposit
POST {{apiUrl}}/api/deposit
Content-Type: application/x-www-form-urlencoded
Application-Type: application/json

user_id = 15 &
amount = 80

### /api/withdraw
POST {{apiUrl}}/api/withdraw
Content-Type: application/x-www-form-urlencoded
Application-Type: application/json

user_id = 13 &
amount = 100

### /api/transfer
POST {{apiUrl}}/api/transfer
Content-Type: application/x-www-form-urlencoded
Application-Type: application/json

from_user_id = 8 &
to_user_id = 15 &
amount = 10

### /api/balance
GET {{apiUrl}}/api/balance?user_id=10&currency=USD
Accept: application/json

### /api/balance
GET {{apiUrl}}/api/balance?user_id=15
Accept: application/json

### /api/transactions
GET {{apiUrl}}/api/transactions?user_id=15&?sortBy=amount&sortDirection=desc&dateFrom=2025-01-11&dateTo=2025-01-31&perPage=15
Accept: application/json
